# Local development only. Copy to .env and choose your own password.
POSTGRES_DB=abby_projects
POSTGRES_USER=abby_projects
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Keep this URL in sync with the values above. URL-encode special characters
# in credentials. Used by the Nuxt server, migrations, and the seed command.
DATABASE_URL=postgresql://abby_projects:change-me-local-only@127.0.0.1:5432/abby_projects

# Seed the single owner with bun run db:seed. There is no public registration.
NUXT_OWNER_EMAIL=
# Generate with bun run auth:hash. Keep the hash in single quotes to preserve $.
NUXT_OWNER_PASSWORD_HASH=''
# Alternatively set a plain password here; the seed hashes it before storage.
# Set only one password option. These values are seed inputs, not login fallbacks.
NUXT_OWNER_PASSWORD=''
# Generate a random secret of at least 32 characters for session encryption.
NUXT_SESSION_PASSWORD=

# Abby API key from https://my.app-abby.com/settings/integrations.
# Server-only: never use a NUXT_PUBLIC_ variable for this key.
NUXT_ABBY_API_KEY=
# Authentication docs use this host; the API schema also lists https://api.abby.fr.
NUXT_ABBY_API_BASE_URL=https://api.app-abby.com
