# Copy to .env.production for Docker Compose, or .env for local Nuxt development.
# Set credentials and a session secret before starting the app.
# These ports bind only to 127.0.0.1 for a reverse proxy running on the host.
APP_PORT=3000
CHARTDB_PORT=8080
# Browser-facing URL, routed by your proxy to ChartDB. Use HTTPS in production.
NUXT_PUBLIC_CHARTDB_URL=https://chartdb.example.com

POSTGRES_DB=abby_projects
POSTGRES_USER=abby_projects
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Raw password: the container entrypoint handles URL encoding automatically.
POSTGRES_PASSWORD=

# Required for local Nuxt, migrations, and owner seed commands.
# Uses the database settings above. For credentials containing URL-reserved
# characters, replace this with a URL containing percent-encoded credentials;
# keep POSTGRES_PASSWORD raw. Existing volumes require their original credentials
# unless reset in SQL.
# Compose generates its own internal URL from POSTGRES_*; it does not forward this.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Optional override for both the Nuxt server and database commands. Leave empty
# to use DATABASE_URL. For a standalone production server, use its reachable DB URL.
NUXT_DATABASE_URL=

# Compose seeds the single owner automatically. Locally, run bun run db:seed.
# There is no public registration.
NUXT_OWNER_EMAIL=
# Generate with bun run auth:hash. Keep the hash in single quotes to preserve $.
NUXT_OWNER_PASSWORD_HASH=''
# Alternatively set a plain password (12-1024 characters); the seed hashes it.
# Set only one password option. These values are seed inputs, not login fallbacks.
NUXT_OWNER_PASSWORD=''
# Random secret of at least 32 characters. Keep it stable across deployments.
NUXT_SESSION_PASSWORD=

# Store the Abby API key in abby_settings.api_key (id = 1); see README.md.
# Authentication docs use this host; the API schema also lists https://api.abby.fr.
NUXT_ABBY_API_BASE_URL=https://api.app-abby.com

# SVG export endpoint for a Nuxt server running outside Docker Compose.
NUXT_CHARTDB_EXPORT_URL=http://localhost:8081
# ChartDB endpoint for the SVG worker when running it outside Docker Compose.
CHARTDB_URL=http://localhost:8080

# Local Nuxt development: configure reachable services for the URLs above.
# Compose keeps PostgreSQL and the SVG worker private by default; expose them
# explicitly or provide separate services. These URLs do not publish ports.
# Compose sets NUXT_CHARTDB_EXPORT_URL and CHARTDB_URL to internal service URLs.
# For a local ChartDB instance, set NUXT_PUBLIC_CHARTDB_URL above to http://localhost:8080.
